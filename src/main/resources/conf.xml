<?xml version="1.0" encoding="utf-8"?>

<conf>
    <!-- 启用的平台 -->
    <enablePlat>uniswap,binance,okcoin</enablePlat>
    <!-- 开仓时，两个平台之间的差价。跟配置文件中平台出现的先后顺序有关：用前一个平台减后一个 -->
    <openPriceGap>0</openPriceGap>
    <lastChange>2016-01-02 10:01:01</lastChange>
    <!-- goods价值占总投资额的比例 -->
    <goodsRate>0.5</goodsRate>
    <!-- changePrice属性为：为了在差价长期不出现反转的平台之间搬运，给查询到的市场挂单价格减去该值，给发送出去的订单加上该值。 -->
    <!-- changePrice = 平台的价格 - 平均值    -->
    <!-- 币从huobi平台流向其它平台时需满足 的最小差价 -->
    <huobi changePrice="0" pgoods="0" pmoney="0">
        <okcoin>0.0</okcoin>
        <binance>0.0</binance>
        <okcoinF>0.0</okcoinF>
        <binanceF>0.0</binanceF>
        <uniswap>0.0</uniswap>
    </huobi>
    <!-- 币从okcoin平台流向其它平台时需满足 的最小差价 -->
    <okcoin changePrice="0" pgoods="0.000" pmoney="0.000">
        <okcoinF>0.0</okcoinF>
        <huobi>0.0</huobi>
        <binance>0.0</binance>
        <binanceF>0.0</binanceF>
        <uniswap>0.39</uniswap>
        <oneInch>0.0</oneInch>
    </okcoin>
    <binance changePrice="0" pgoods="0.000" pmoney="0.000">
        <okcoinF>0.0</okcoinF>
        <huobi>0.0</huobi>
        <okcoin>0.0</okcoin>
        <binanceF>0.0</binanceF>
        <uniswap>5.83</uniswap>
        <oneInch>0.0</oneInch>
    </binance>
    <okcoinF changePrice="0" pgoods="0" pmoney="0">
        <okcoin>0.0</okcoin>
        <huobi>0.0</huobi>
        <binance>0.0</binance>
        <binanceF>0.0</binanceF>
        <uniswap>0.0</uniswap>
    </okcoinF>
    <binanceF changePrice="0" pgoods="0" pmoney="0">
        <okcoinF>0.0</okcoinF>
        <huobi>0.0</huobi>
        <okcoin>0.0</okcoin>
        <binance>0.0</binance>
        <uniswap>0.0</uniswap>
    </binanceF>
    <uniswap changePrice="0" pgoods="1.000" pmoney="1.000">
        <okcoinF>0.0</okcoinF>
        <huobi>0.0</huobi>
        <okcoin>6.85</okcoin>
        <binance>3.84</binance>
        <binanceF>0.0</binanceF>
        <oneInch>0.0</oneInch>
    </uniswap>
    <oneInch changePrice="0" pgoods="0.999" pmoney="0.999">
        <okcoinF>0.0</okcoinF>
        <huobi>0.0</huobi>
        <okcoin>0.0</okcoin>
        <binance>0.0</binance>
        <binanceF>0.0</binanceF>
        <uniswap>0.0</uniswap>
    </oneInch>
    <!-- 第一条余额记录。格式：时间,总收入,本次收入,当前money,当前btc,okcoinMoney,okcoinGoods,chbtcMoney,chbtcGoods,当前价格, -->
    <firstBalance>dateTime:2024-02-06 00:00:00,totalEarn:0.0,thisEarn:0.0,totalMoney:5343.868873694773,totalGoods:1.820275734304417,{uniswapMoney:7094.5,uniswapGoods:3.5,okcoinMoney:0,binanceGoods:8.47260449},price:28024.0,</firstBalance>
